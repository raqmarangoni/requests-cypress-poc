{
  "_version": "1.65.0",
  "sap.app": {
    "id": "qa.solicitacoes",
    "type": "application",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "Solicitações",
    "description": "Cadastro e consulta de solicitações",
    "crossNavigation": {
      "inbounds": {
        "solicitacoes-display": {
          "semanticObject": "Solicitacoes",
          "action": "display",
          "title": "Solicitações",
          "subTitle": "Cadastro e consulta",
          "icon": "sap-icon://request",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "qa.solicitacoes"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "qa.solicitacoes.view.Main",
      "type": "XML",
      "id": "main",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "solicitacoes": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "formulario": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    }
  }
}
